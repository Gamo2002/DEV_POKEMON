# ----------------------------------------------------------------
# Arquivo .gitignore para um projeto Python (TCC)
# ----------------------------------------------------------------

# 1. A PASTA MAIS IMPORTANTE A IGNORAR: O Ambiente Virtual
# Isso impede que milhões de arquivos da biblioteca sejam enviados
# para o GitHub, como conversamos.
venv/
/venv/
*.venv

# 2. Arquivos de Cache e Compilados do Python
# O Python cria essas pastas para rodar mais rápido,
# não precisamos delas no repositório.
__pycache__/
*.pyc

# 3. Arquivos de Configuração de Editores
# Ignora configurações pessoais do seu editor
.vscode/
.idea/

# 4. Arquivos de Sistema Operacional
# Lixo do Windows ou macOS
.DS_Store
desktop.ini
Thumbs.db

# 5. Arquivos de Dependências e "Segredos"
# Você nunca deve enviar senhas ou chaves de API para o GitHub
.env
*.env
credentials.json

# 6. Pastas de Teste e Relatórios
# (Opcional, mas recomendado)
/build/
/dist/
*.egg-info/
/coverage/